{
  "appId": "com.packmatesai.app",
  "appName": "Packmates AI",
  "webDir": "www",
  "server": {
    "url": "https://packmatesai.com",
    "cleartext": false,
    "allowNavigation": ["packmatesai.com", "*.packmatesai.com"]
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "backgroundColor": "#eef1f5"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "backgroundColor": "#0d3347",
      "showSpinner": true,
      "spinnerColor": "#5f9d30",
      "iosSpinnerStyle": "large"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#0d3347",
      "overlaysWebView": true
    }
  }
}
