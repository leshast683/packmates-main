# Environment variables required by api/*.js (Vercel serverless functions).
# Set these in the Vercel dashboard: Project → Settings → Environment Variables.
# A missing one fails at request time with a generic 500 ("Server
# configuration error") rather than at deploy time — this file exists so
# a gap is visible before that happens, not after (SUPABASE_SERVICE_KEY
# was missing in production for an unknown period before being found by
# testing /api/delete-account directly).

# ── Supabase ──────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
# Used by: api/delete-account.js, api/pexels.js, api/log-error.js, api/destination-brief.js, api/send-welcome-email.js
SUPABASE_URL=

# Public anon/publishable key (safe to expose client-side too — RLS is
# what actually protects data, not secrecy of this key).
# Used by: api/delete-account.js, api/pexels.js, api/log-error.js, api/destination-brief.js, api/send-welcome-email.js
SUPABASE_ANON_KEY=

# SECRET service_role key — bypasses RLS entirely. Get from Supabase
# Dashboard → Settings → API → Project API keys → service_role.
# Never expose this to the client. Used by api/delete-account.js (ownership
# transfer + admin user deletion), api/send-welcome-email.js (claiming the
# one-time send via profiles.welcome_email_sent), and
# api/send-newsletter.js / api/unsubscribe-newsletter.js (recipient lookup
# via the auth admin API + the unsubscribe_newsletter() RPC).
SUPABASE_SERVICE_KEY=

# ── Third-party APIs ─────────────────────────────────────────────────
# Anthropic API key for the AI destination-brief feature (visa/currency/
# weather/safety summaries). Used by: api/destination-brief.js
ANTHROPIC_API_KEY=

# Pexels API key for destination/activity photo search. Proxied server-side
# so the key is never shipped to the client. Used by: api/pexels.js
PEXELS_API_KEY=

# Resend API key for transactional/newsletter email. Get from
# https://resend.com/api-keys. The "from" addresses (welcome@packmatesai.com,
# newsletter@packmatesai.com) must belong to a domain verified in Resend's
# dashboard, or sends will fail. Used by: api/send-welcome-email.js,
# api/send-newsletter.js
RESEND_API_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# triggers api/send-newsletter.js (see vercel.json's `crons` entry) — without
# this, the endpoint would be a public URL anyone could hit to force-send
# that week's newsletter early. Generate any random string, e.g.
# `openssl rand -hex 32`. Used by: api/send-newsletter.js
CRON_SECRET=
